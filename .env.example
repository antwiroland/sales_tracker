# ----- Database -----
# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/sales-kpi)
MONGODB_URI=

# ----- NextAuth -----
# Generate a secret with:  npx auth secret   (or)  openssl rand -base64 32
AUTH_SECRET=
# Base URL of the app
NEXTAUTH_URL=http://localhost:3000

# ----- Cloudinary (image storage) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public cloud name used by the client uploader (same as CLOUDINARY_CLOUD_NAME)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ----- Localisation (optional) -----
# Currency symbol and number/date locale shown across the app
NEXT_PUBLIC_CURRENCY=GH₵
NEXT_PUBLIC_LOCALE=en-GH

# ----- Seed -----
# Password applied to all seeded demo accounts
SEED_PASSWORD=Password123!
